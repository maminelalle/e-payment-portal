# Production : un seul domaine en HTTPS (${PORTAL_HOST}).
#   /            application Angular (fichiers statiques)
#   /api/        backend Spring Boot
#   /auth/       Keycloak (connexion, MFA, comptes)
#   /simulateur/ simulateur des fournisseurs (page carte publique, webhooks sortants)
# Les certificats sont montés dans /etc/nginx/certs (fullchain.pem, privkey.pem).

server_tokens off;
# DNS de Docker, relu toutes les 10 s : un service recréé (nouvelle IP) reste joignable sans redémarrer Nginx.
resolver 127.0.0.11 valid=10s ipv6=off;
client_max_body_size 10m;

# Limite de débit sur l'API publique (vérification de reçus, statut) et sur les envois de la connexion.
# Pour Keycloak, seuls les POST comptent (identifiants, code TOTP, jeton) : les styles et scripts de la page
# de connexion n'épuisent pas le quota de plusieurs employés derrière la même adresse IP.
map $request_method $auth_limit_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $binary_remote_addr zone=public:10m rate=30r/m;
limit_req_zone $auth_limit_key zone=auth:10m rate=30r/m;
limit_req_status 429;

server {
    listen 80;
    server_name ${PORTAL_HOST};
    location / {
        return 301 https://$host${HTTPS_PORT_SUFFIX}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PORTAL_HOST};

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    include /etc/nginx/snippets/security-headers.conf;

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Port ${HTTPS_PORT};

    set $backend http://backend:8080;
    set $keycloak http://keycloak:8080;
    set $simulator http://simulator:8090;

    location /api/public/ {
        limit_req zone=public burst=20 nodelay;
        proxy_pass $backend;
    }

    location /api/ {
        proxy_pass $backend;
        proxy_read_timeout 60s;
    }

    # Sonde de santé uniquement ; le reste d'Actuator n'est pas exposé publiquement.
    location = /actuator/health {
        proxy_pass $backend;
    }
    location /actuator/ {
        return 404;
    }

    location /auth/ {
        limit_req zone=auth burst=20 nodelay;
        proxy_pass $keycloak;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
    }
    # Console d'administration Keycloak : jamais exposée sur Internet (accès par le réseau interne).
    location /auth/admin/ {
        return 404;
    }

    location /simulateur/ {
        proxy_pass $simulator;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

        # Fichiers au nom versionné par le build (main-UWA4HXS3.js…) : cache d'un an, jamais modifiés.
        location ~* "-[A-Z0-9]{8}\.(?:js|css)$" {
            expires 1y;
            include /etc/nginx/snippets/security-headers.conf;
            add_header Cache-Control "public, immutable";
        }
        # Logo, manifeste, images, polices : nom fixe, donc revalidés chaque jour (un nouveau logo apparaît vite).
        location ~* \.(?:svg|png|ico|webmanifest|woff2?)$ {
            include /etc/nginx/snippets/security-headers.conf;
            add_header Cache-Control "public, max-age=86400, must-revalidate";
        }
        location = /index.html {
            include /etc/nginx/snippets/security-headers.conf;
            add_header Cache-Control "no-cache";
            add_header X-Frame-Options "DENY" always;
            add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        }
    }
}
