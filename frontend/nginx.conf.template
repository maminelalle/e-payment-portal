# Production : un seul domaine en HTTPS (${PORTAL_HOST}).
#   /            application Angular (fichiers statiques)
#   /api/        backend Spring Boot
#   /auth/       Keycloak (connexion, MFA, comptes)
#   /simulateur/ simulateur des fournisseurs (page carte publique, webhooks sortants)
# Les certificats sont montés dans /etc/nginx/certs (fullchain.pem, privkey.pem).

server_tokens off;
# DNS de Docker, relu toutes les 10 s : un service recréé (nouvelle IP) reste joignable sans redémarrer Nginx.
resolver 127.0.0.11 valid=10s ipv6=off;
client_max_body_size 10m;

# Limite de débit sur l'API publique (vérification de reçus, statut) et la connexion.
limit_req_zone $binary_remote_addr zone=public:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=auth:10m rate=60r/m;

server {
    listen 80;
    server_name ${PORTAL_HOST};
    location / {
        return 301 https://$host${HTTPS_PORT_SUFFIX}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PORTAL_HOST};

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Port ${HTTPS_PORT};

    set $backend http://backend:8080;
    set $keycloak http://keycloak:8080;
    set $simulator http://simulator:8090;

    location /api/public/ {
        limit_req zone=public burst=20 nodelay;
        proxy_pass $backend;
    }

    location /api/ {
        proxy_pass $backend;
        proxy_read_timeout 60s;
    }

    # Sonde de santé uniquement ; le reste d'Actuator n'est pas exposé publiquement.
    location = /actuator/health {
        proxy_pass $backend;
    }
    location /actuator/ {
        return 404;
    }

    location /auth/ {
        limit_req zone=auth burst=40 nodelay;
        proxy_pass $keycloak;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
    }
    # Console d'administration Keycloak : jamais exposée sur Internet (accès par le réseau interne).
    location /auth/admin/ {
        return 404;
    }

    location /simulateur/ {
        proxy_pass $simulator;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;

        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

        location ~* \.(?:js|css|woff2?|svg|png|ico)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
            add_header Strict-Transport-Security "max-age=31536000" always;
            add_header X-Content-Type-Options "nosniff" always;
        }
        location = /index.html {
            add_header Cache-Control "no-cache";
            add_header Strict-Transport-Security "max-age=31536000" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
            add_header X-Frame-Options "DENY" always;
            add_header X-Content-Type-Options "nosniff" always;
        }
    }
}
