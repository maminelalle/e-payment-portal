{
  "realm": "epayment",
  "displayName": "E-Payment",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "internationalizationEnabled": true,
  "supportedLocales": ["fr"],
  "defaultLocale": "fr",
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername and passwordHistory(3)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "adminEventsEnabled": true,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "browserFlow": "browser-mfa-admin",
  "authenticatorConfig": [
    { "alias": "role-admin", "config": { "condUserRole": "ADMIN", "negate": "false" } }
  ],
  "authenticationFlows": [
    {
      "alias": "browser-mfa-admin",
      "description": "Connexion navigateur : mot de passe pour tous, code TOTP en plus pour le rôle ADMIN",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie", "requirement": "ALTERNATIVE", "priority": 10, "autheticatorFlow": false, "userSetupAllowed": false },
        { "requirement": "ALTERNATIVE", "priority": 20, "autheticatorFlow": true, "flowAlias": "browser-mfa-admin forms", "userSetupAllowed": false }
      ]
    },
    {
      "alias": "browser-mfa-admin forms",
      "description": "Identifiant et mot de passe, puis OTP conditionnel",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-username-password-form", "requirement": "REQUIRED", "priority": 10, "autheticatorFlow": false, "userSetupAllowed": false },
        { "requirement": "CONDITIONAL", "priority": 20, "autheticatorFlow": true, "flowAlias": "browser-mfa-admin otp admin", "userSetupAllowed": false }
      ]
    },
    {
      "alias": "browser-mfa-admin otp admin",
      "description": "Code TOTP exigé si l'utilisateur a le rôle ADMIN (configuration au premier passage)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-user-role", "authenticatorConfig": "role-admin", "requirement": "REQUIRED", "priority": 10, "autheticatorFlow": false, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "requirement": "REQUIRED", "priority": 20, "autheticatorFlow": false, "userSetupAllowed": false }
      ]
    }
  ],
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Administrateur du portail" },
      { "name": "ABONNE", "description": "Abonné" }
    ]
  },
  "clients": [
    {
      "clientId": "epayment-frontend",
      "name": "Portail E-Payment",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "rootUrl": "http://localhost",
      "redirectUris": ["http://localhost/*", "http://localhost:4200/*"],
      "webOrigins": ["http://localhost", "http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost/*##http://localhost:4200/*"
      }
    }
  ],
  "users": [
    {
      "username": "admin@epayment.mr",
      "email": "admin@epayment.mr",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Démo",
      "enabled": true,
      "realmRoles": ["ADMIN"],
      "credentials": [{ "type": "password", "value": "Admin#Demo2026", "temporary": false }]
    },
    {
      "username": "contact@exemple.mr",
      "email": "contact@exemple.mr",
      "emailVerified": true,
      "firstName": "Société",
      "lastName": "ABC",
      "enabled": true,
      "realmRoles": ["ABONNE"],
      "credentials": [{ "type": "password", "value": "Abonne#Demo2026", "temporary": false }]
    }
  ]
}
