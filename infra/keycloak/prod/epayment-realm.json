{
  "realm": "epayment",
  "displayName": "E-Payment",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr"
  ],
  "defaultLocale": "fr",
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername and passwordHistory(3)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "actionTokenGeneratedByAdminLifespan": 259200,
  "smtpServer": {
    "host": "${MAIL_HOST}",
    "port": "${MAIL_PORT}",
    "from": "${MAIL_FROM_ADDRESS}",
    "fromDisplayName": "Portail E-Payment",
    "auth": "${MAIL_AUTH}",
    "user": "${MAIL_USER}",
    "password": "${MAIL_PASSWORD}",
    "ssl": "false",
    "starttls": "${MAIL_STARTTLS}"
  },
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "adminEventsEnabled": true,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "browserFlow": "browser-mfa-admin",
  "authenticatorConfig": [
    {
      "alias": "role-admin",
      "config": {
        "condUserRole": "ADMIN",
        "negate": "false"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "browser-mfa-admin",
      "description": "Connexion navigateur : mot de passe pour tous, code TOTP en plus pour le rôle ADMIN",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "autheticatorFlow": true,
          "flowAlias": "browser-mfa-admin forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-mfa-admin forms",
      "description": "Identifiant et mot de passe, puis OTP conditionnel",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "autheticatorFlow": true,
          "flowAlias": "browser-mfa-admin otp admin",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-mfa-admin otp admin",
      "description": "Code TOTP exigé si l'utilisateur a le rôle ADMIN (configuration au premier passage)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "role-admin",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administrateur du portail"
      },
      {
        "name": "ABONNE",
        "description": "Abonné"
      }
    ]
  },
  "clients": [
    {
      "clientId": "epayment-backend",
      "name": "Backend E-Payment (gestion des comptes abonnés)",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_BACKEND_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false
    },
    {
      "clientId": "epayment-frontend",
      "name": "Portail E-Payment",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "rootUrl": "${PORTAL_URL}",
      "redirectUris": [
        "${PORTAL_URL}/*"
      ],
      "webOrigins": [
        "${PORTAL_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${PORTAL_URL}/*"
      }
    }
  ],
  "users": [
    {
      "username": "service-account-epayment-backend",
      "enabled": true,
      "serviceAccountClientId": "epayment-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm"
        ]
      }
    },
    {
      "username": "${KEYCLOAK_FIRST_ADMIN_EMAIL}",
      "email": "${KEYCLOAK_FIRST_ADMIN_EMAIL}",
      "emailVerified": true,
      "firstName": "Administrateur",
      "lastName": "E-Payment",
      "enabled": true,
      "realmRoles": [
        "ADMIN"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_FIRST_ADMIN_PASSWORD}",
          "temporary": true
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"Nom ou raison sociale\",\"validations\":{\"length\":{\"max\":200},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":200},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
