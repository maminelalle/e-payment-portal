# Copier en infra/.env.prod (jamais commité) et remplacer chaque valeur « a-changer ».
# Générer un secret : openssl rand -base64 32

# Domaine public
PORTAL_HOST=epayment.example.mr
PORTAL_URL=https://epayment.example.mr
HTTP_PORT=80
HTTPS_PORT=443
# Laisser vide sur le port 443 ; « :8443 » si HTTPS_PORT=8443 (recette locale)
HTTPS_PORT_SUFFIX=
CERTS_DIR=./certs

# Base de données
DB_USER=epayment
DB_PASSWORD=a-changer
KEYCLOAK_DB_PASSWORD=a-changer

# Keycloak : console d'administration (réseau interne uniquement) et premier administrateur du portail
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=a-changer
KEYCLOAK_BACKEND_SECRET=a-changer
KEYCLOAK_FIRST_ADMIN_EMAIL=admin@example.mr
# Temporaire : à changer à la première connexion, puis TOTP obligatoire.
# Politique du realm : 12 caractères min., une majuscule, une minuscule, un chiffre, un caractère spécial.
KEYCLOAK_FIRST_ADMIN_PASSWORD=a-changer

# Emails (Keycloak et portail)
MAIL_HOST=smtp.example.mr
MAIL_PORT=587
MAIL_FROM_ADDRESS=no-reply@example.mr
MAIL_AUTH=true
MAIL_USER=no-reply@example.mr
MAIL_PASSWORD=a-changer
MAIL_STARTTLS=true

# Stockage des documents (SeaweedFS interne)
S3_ACCESS_KEY=epayment
S3_SECRET_KEY=a-changer
S3_BUCKET=epayment-documents

# Secrets applicatifs
SIGNATURE_OTP_SECRET=a-changer
RECEIPT_VERIFICATION_SECRET=a-changer
# Chiffrement des NNI / NIF en base : 32 octets aléatoires en base64 (openssl rand -base64 32).
# À conserver avec les sauvegardes : sans elle, les identifiants restaurés sont illisibles. Ne jamais la changer.
DATA_ENCRYPTION_KEY=a-generer
# Certificat de scellement PKCS#12 déposé dans infra/secrets/ (vide = certificat auto-signé, à éviter)
SIGNATURE_SEAL_KEYSTORE=
SIGNATURE_SEAL_KEYSTORE_PASSWORD=

# Fournisseurs (simulateur) : mêmes valeurs côté portail et côté simulateur
BANKILY_API_KEY=a-changer
BANKILY_WEBHOOK_SECRET=a-changer
MASRVI_API_KEY=a-changer
MASRVI_WEBHOOK_SECRET=a-changer
VISA_API_KEY=a-changer
VISA_WEBHOOK_SECRET=a-changer

# Sauvegardes
BACKUP_HOST_DIR=./backups
BACKUP_TIME=02:30
BACKUP_RETENTION_DAYS=30
# Copie externe (recommandée) : un autre stockage S3, hors du serveur
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_BUCKET=
OFFSITE_ACCESS_KEY=
OFFSITE_SECRET_KEY=
